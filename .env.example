# Copy to .env.local for local dev. On Vercel, add the same keys under Project → Settings → Environment Variables.

# Supabase → Project Settings → Database → Connection string
# Transaction pooler (port 6543) for the app:
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Session/direct connection (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API (server-only; used for the private "resumes" bucket)
SUPABASE_URL="https://<ref>.supabase.co"
# The new-style secret key (sb_secret_...) or the legacy service_role key both work.
SUPABASE_SERVICE_ROLE_KEY=""

# LLM — Google AI Studio key (free tier). Groq is an optional fallback.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-lite-latest"  (falls back to gemini-flash-latest when busy)
GROQ_API_KEY=""

# Single-user login. Leave APP_PASSWORD empty to disable the gate (local dev only).
APP_PASSWORD=""
AUTH_SECRET="any-long-random-string"

# Optional: override the funding feeds — "Name|url,Name|url"
# FUNDING_FEEDS=""

# --- Phase 2: Easy Apply ---
# Google Cloud → APIs & Services → Credentials → OAuth client (Web). Redirect URI:
#   https://<your-app>.vercel.app/api/google/callback  (and http://localhost:3000/api/google/callback for dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: pin the public URL used in the OAuth redirect (defaults to the request's origin)
# APP_URL="https://<your-app>.vercel.app"

# Optional email finders (each used only if set; otherwise emails are guessed from common formats)
HUNTER_API_KEY=""
APOLLO_API_KEY=""
# DAILY_SEND_CAP=15

# --- Phase 3 ---
# Enables the daily reply check (vercel.json cron). Any long random string.
CRON_SECRET=""
# FOLLOW_UP_DAYS=3
